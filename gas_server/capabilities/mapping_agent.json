{
  "$schema": "https://www.geospatial-agentic-services.online/schemas/describe_agent.schema.json",
  "profile": {
    "agent_id": "mapping_agent",
    "name": "Mapping Agent",
    "category": "Map",
    "description": "Produces deterministic HTML maps from supplied vector, raster, or joined tabular-spatial artifacts. Visualizes the specified field and embeds verification metadata.",
    "version": "2.0.0",
    "base_url": "https://www.geospatial-agentic-services.online/agents/mapping_agent",
    "default_model": null
  },
  "keywords": [
    "choropleth",
    "thematic map",
    "HTML map",
    "Leaflet",
    "spatial visualization"
  ],
  "skills": [
    {
      "skill_id": "thematic_mapping",
      "name": "Thematic Mapping",
      "description": "Generates interactive HTML choropleth and vector boundary maps from GeoPackage or GeoJSON layers.",
      "constraints": {
        "spatial": "Visualizes the specified spatial features and mapped attributes.",
        "temporal": null,
        "other": [
          "Embeds source artifact and CRS verification metadata in output HTML."
        ]
      }
    }
  ],
  "execute_task": {
    "operation_id": "execute_task",
    "name": "ExecuteTask",
    "description": "Submits a mapping or visualization task on a vector or raster layer.",
    "request_schema": "https://www.geospatial-agentic-services.online/schemas/execute_task_request.schema.json",
    "response_schema": "https://www.geospatial-agentic-services.online/schemas/task_response.schema.json",
    "modes": ["sync"],
    "task": {
      "instructions": {
        "required": true,
        "description": "Mapping instruction (e.g. create a choropleth map of median income across census tracts)."
      }
    },
    "inputs": {
      "input_datasets": {
        "required": true,
        "description": "Input vector or raster layer in GeoPackage or GeoJSON format."
      }
    },
    "outputs": {
      "artifact_delivery": {
        "required": false,
        "default": "URL",
        "allowed_values": ["URL", "Encoded"]
      },
      "primary_artifacts": [
        {
          "type": "map",
          "formats": ["HTML"],
          "required": true,
          "description": "Interactive HTML visualization map."
        }
      ]
    },
    "parameters": {
      "field": {
        "required": false,
        "description": "Attribute column name to visualize/classify."
      }
    },
    "credentials": {
      "required": false
    }
  },
  "conformance": {
    "gas_version": "1.0.0",
    "schemas": {
      "describe_agent": "https://www.geospatial-agentic-services.online/schemas/describe_agent.schema.json",
      "task_response": "https://www.geospatial-agentic-services.online/schemas/task_response.schema.json",
      "execute_task_request": "https://www.geospatial-agentic-services.online/schemas/execute_task_request.schema.json"
    }
  }
}
