{
  "$schema": "https://www.geospatial-agentic-services.online/schemas/describe_agent.schema.json",
  "profile": {
    "agent_id": "statistics_agent",
    "name": "Statistics Agent",
    "category": "Analyze",
    "description": "Performs deterministic tabular summaries and grouped aggregation on attribute datasets.",
    "version": "2.0.0",
    "base_url": "https://www.geospatial-agentic-services.online/agents/statistics_agent",
    "default_model": null
  },
  "keywords": [
    "statistics",
    "grouped aggregation",
    "summary statistics",
    "tabular analysis",
    "metrics"
  ],
  "skills": [
    {
      "skill_id": "tabular_aggregation",
      "name": "Tabular Aggregation and Statistics",
      "description": "Computes statistical summaries, grouped means/sums/counts across categorical or temporal fields (e.g. monthly grouping).",
      "constraints": {
        "spatial": null,
        "temporal": "Can aggregate by temporal fields such as month or year.",
        "other": [
          "Pure deterministic tabular computation."
        ]
      }
    }
  ],
  "execute_task": {
    "operation_id": "execute_task",
    "name": "ExecuteTask",
    "description": "Submits a tabular summary or grouped aggregation task on a CSV or attribute table.",
    "request_schema": "https://www.geospatial-agentic-services.online/schemas/execute_task_request.schema.json",
    "response_schema": "https://www.geospatial-agentic-services.online/schemas/task_response.schema.json",
    "modes": ["sync"],
    "task": {
      "instructions": {
        "required": true,
        "description": "Aggregation or summary instruction (e.g. summarize daily temperature by month)."
      }
    },
    "inputs": {
      "input_datasets": {
        "required": true,
        "description": "Input CSV table or attribute layer."
      }
    },
    "outputs": {
      "artifact_delivery": {
        "required": false,
        "default": "URL",
        "allowed_values": ["URL", "Encoded"]
      },
      "primary_artifacts": [
        {
          "type": "table",
          "formats": ["CSV"],
          "required": true,
          "description": "Summarized tabular dataset."
        }
      ]
    },
    "parameters": {
      "group_by": {
        "required": false,
        "description": "Column name to group by (e.g. month, year)."
      },
      "value_field": {
        "required": false,
        "description": "Numerical column name to aggregate."
      },
      "statistic": {
        "required": false,
        "default": "mean",
        "description": "Aggregation function (mean, sum, max, min, count)."
      }
    },
    "credentials": {
      "required": false
    }
  },
  "conformance": {
    "gas_version": "1.0.0",
    "schemas": {
      "describe_agent": "https://www.geospatial-agentic-services.online/schemas/describe_agent.schema.json",
      "task_response": "https://www.geospatial-agentic-services.online/schemas/task_response.schema.json",
      "execute_task_request": "https://www.geospatial-agentic-services.online/schemas/execute_task_request.schema.json"
    }
  }
}
